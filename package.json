{
  "name": "personality-code-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:item-bank": "node scripts/validate-item-bank.mjs && node scripts/validate-reviewed-item-bank.mjs",
    "validate:persistence": "node scripts/validate-persistence-schema.mjs",
    "test:domain": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node --test .tmp-tests/tests/domain/scoring.test.js .tmp-tests/tests/domain/candidate-bank.test.js .tmp-tests/tests/domain/reviewed-item-bank.test.js .tmp-tests/tests/domain/personality-code.test.js .tmp-tests/tests/domain/interactions.test.js .tmp-tests/tests/domain/content-composer.test.js .tmp-tests/tests/domain/result-engine.test.js .tmp-tests/tests/domain/result-snapshot.test.js .tmp-tests/tests/infrastructure/session-token.test.js",
    "test:persistence:integration": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/postgres-integration.mjs && node --test .tmp-tests/tests/infrastructure/anonymous-assessment-repository.integration.test.js",
    "seed:dev": "node scripts/seed-development-model.mjs",
    "test:seed:dev": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/development-seed.integration.mjs && node --test .tmp-tests/tests/infrastructure/assessment-model-repository.integration.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.2"
  }
}
