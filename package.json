{
  "name": "personality-code-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:requirements": "node scripts/validate-requirement-ids.mjs",
    "validate:type-catalog": "node scripts/validate-type-catalog.mjs && node scripts/validate-type-display-names.mjs",
    "validate:illustration": "node scripts/validate-illustration-slots.mjs",
    "validate:content": "node scripts/validate-content-v0.2.mjs && node scripts/validate-content-v0.3.mjs",
    "validate:item-bank": "node scripts/validate-item-bank.mjs && node scripts/validate-reviewed-item-bank.mjs",
    "validate:persistence": "node scripts/validate-persistence-schema.mjs",
    "test:domain": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node --test .tmp-tests/tests/domain/scoring.test.js .tmp-tests/tests/domain/candidate-bank.test.js .tmp-tests/tests/domain/reviewed-item-bank.test.js .tmp-tests/tests/domain/personality-code.test.js .tmp-tests/tests/domain/interactions.test.js .tmp-tests/tests/domain/content-composer.test.js .tmp-tests/tests/domain/result-engine.test.js .tmp-tests/tests/domain/result-snapshot.test.js .tmp-tests/tests/domain/share-snapshot.test.js tests/domain/result-snapshot-v0.2.mjs tests/domain/result-snapshot-v0.3.mjs .tmp-tests/tests/infrastructure/session-token.test.js .tmp-tests/tests/infrastructure/public-share-token.test.js .tmp-tests/tests/domain/product-event.test.js",
    "test:persistence:integration": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/postgres-integration.mjs && node --test .tmp-tests/tests/infrastructure/anonymous-assessment-repository.integration.test.js .tmp-tests/tests/infrastructure/public-share-repository.integration.test.js .tmp-tests/tests/infrastructure/analytics-repository.integration.test.js",
    "seed:dev": "node scripts/seed-development-model.mjs",
    "test:seed:dev": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/development-seed.integration.mjs && node --test .tmp-tests/tests/infrastructure/assessment-model-repository.integration.test.js .tmp-tests/tests/application/server-assessment-service.integration.test.js",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "validate:analytics": "node scripts/validate-analytics-events.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.2"
  }
}
