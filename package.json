{
  "name": "personality-code-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:requirements": "node scripts/validate-requirement-ids.mjs",
    "validate:type-catalog": "node scripts/validate-type-catalog.mjs && node scripts/validate-type-display-names.mjs && node scripts/validate-type-editorial-catalog.mjs",
    "validate:illustration": "node scripts/validate-illustration-slots.mjs && node scripts/validate-illustration-briefs.mjs && node scripts/validate-illustration-fallback.mjs",
    "validate:content": "node scripts/validate-content-v0.2.mjs && node scripts/validate-content-v0.3.mjs",
    "validate:item-bank": "node scripts/validate-item-bank.mjs && node scripts/validate-reviewed-item-bank.mjs",
    "validate:persistence": "node scripts/validate-persistence-schema.mjs",
    "test:domain": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node --test .tmp-tests/tests/domain/scoring.test.js .tmp-tests/tests/domain/candidate-bank.test.js .tmp-tests/tests/domain/reviewed-item-bank.test.js .tmp-tests/tests/domain/personality-code.test.js .tmp-tests/tests/domain/interactions.test.js .tmp-tests/tests/domain/content-composer.test.js .tmp-tests/tests/domain/result-engine.test.js .tmp-tests/tests/domain/result-snapshot.test.js .tmp-tests/tests/domain/share-snapshot.test.js tests/domain/result-snapshot-v0.2.mjs tests/domain/result-snapshot-v0.3.mjs .tmp-tests/tests/infrastructure/session-token.test.js .tmp-tests/tests/infrastructure/public-share-token.test.js .tmp-tests/tests/domain/product-event.test.js .tmp-tests/tests/domain/observed-type-distribution.test.js .tmp-tests/tests/domain/observedDistributionPublication.test.js .tmp-tests/tests/domain/web-vitals.test.js",
    "test:persistence:integration": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/postgres-integration.mjs && node --test .tmp-tests/tests/infrastructure/anonymous-assessment-repository.integration.test.js .tmp-tests/tests/infrastructure/public-share-repository.integration.test.js .tmp-tests/tests/infrastructure/analytics-repository.integration.test.js .tmp-tests/tests/infrastructure/rate-limit-repository.integration.test.js .tmp-tests/tests/infrastructure/anonymous-data-deletion-repository.integration.test.js",
    "seed:dev": "node scripts/seed-development-model.mjs",
    "test:seed:dev": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.domain-tests.json && node tests/infrastructure/development-seed.integration.mjs && node --test .tmp-tests/tests/infrastructure/assessment-model-repository.integration.test.js .tmp-tests/tests/application/server-assessment-service.integration.test.js",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "validate:analytics": "node scripts/validate-analytics-events.mjs",
    "cleanup:analytics": "node scripts/cleanup-analytics-retention.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:security": "node scripts/validate-security-baseline.mjs",
    "audit:release-security": "node scripts/validate-release-security.mjs",
    "audit:production-build": "node scripts/audit-production-build.mjs",
    "validate:privacy-data": "node scripts/validate-privacy-data-inventory.mjs",
    "validate:landing-claims": "node scripts/validate-landing-claims.mjs",
    "audit:performance-build": "node scripts/audit-performance-build.mjs",
    "validate:calibration": "node scripts/validate-calibration-protocol.mjs",
    "validate:release-operations": "node scripts/validate-release-operations.mjs",
    "validate:environment": "node scripts/validate-environment-contract.mjs",
    "validate:launch-gate": "node scripts/validate-public-launch-gate.mjs",
    "validate:legal-draft": "node scripts/validate-legal-disclosure-draft.mjs",
    "validate:security-release-review": "node scripts/validate-security-release-review.mjs",
    "validate:observed-distribution": "node scripts/validate-observed-distribution-publication.mjs",
    "validate:type-editorial-review": "node scripts/validate-type-editorial-review-gate.mjs && node scripts/validate-type-editorial-review-worklist.mjs",
    "validate:user-deletion": "node scripts/validate-user-deletion.mjs",
    "validate:performance-lab": "node scripts/validate-performance-lab-evidence.mjs",
    "test:performance:lab": "playwright test -c playwright.performance.config.ts",
    "validate:a11y-release": "node scripts/validate-manual-accessibility-release.mjs",
    "generate:type-editorial-review-worklist": "node scripts/materialize-type-editorial-review-worklist.mjs",
    "validate:observability": "node scripts/validate-observability-contract.mjs",
    "validate:model-activation": "node scripts/validate-production-model-activation.mjs",
    "cleanup:diagnostic": "node scripts/cleanup-diagnostic-retention.mjs",
    "test:diagnostic-retention:integration": "node tests/infrastructure/diagnostic-retention.integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.2"
  }
}
