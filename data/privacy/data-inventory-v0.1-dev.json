{
  "inventory_version": "privacy-data-inventory-v0.1-dev",
  "status": "development",
  "account_required": false,
  "direct_identity_collection": false,
  "precise_location_collection": false,
  "third_party_diagnostic_export_default": false,
  "classes": [
    {
      "id": "versioned-product-definition",
      "personal_data": false,
      "purpose": "Deterministic assessment, scoring, content, artwork and historical reproducibility.",
      "retention": "indefinite-while-referenced",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "trait_definitions",
        "trait_definition_revisions",
        "assessment_items",
        "assessment_item_revisions",
        "assessment_model_releases",
        "assessment_model_items",
        "content_versions",
        "content_modules",
        "illustration_assets"
      ]
    },
    {
      "id": "anonymous-session-operational",
      "personal_data": true,
      "purpose": "Resume an anonymous assessment and bind writes/results to one opaque browser capability.",
      "retention": "abandoned-30-days-engineering-baseline",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "anonymous_sessions"
      ]
    },
    {
      "id": "anonymous-diagnostic-answers",
      "personal_data": true,
      "purpose": "Compute deterministic Trait Scores and permit short-term support/reliability investigation during MVP/beta.",
      "retention": "completed-90-days-engineering-baseline",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "assessment_answers"
      ]
    },
    {
      "id": "derived-private-diagnostic-result",
      "personal_data": true,
      "purpose": "Render and reproduce the private deterministic result without recomputing against mutable content.",
      "retention": "private-result-180-days-engineering-baseline",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "assessment_trait_scores",
        "result_snapshots"
      ]
    },
    {
      "id": "explicit-public-share",
      "personal_data": true,
      "purpose": "Store the separately sanitized result identity explicitly exported by the user for sharing.",
      "retention": "until-revoked-or-future-public-share-policy",
      "public_by_default": false,
      "public_after_explicit_action": true,
      "third_party_export_default": false,
      "tables": [
        "public_share_snapshots"
      ]
    },
    {
      "id": "first-party-product-analytics",
      "personal_data": true,
      "purpose": "Measure product funnel, coarse errors and bucketed performance without copying diagnostic answers/results.",
      "retention": "30-days-unscoped-90-days-session-bound",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "product_events"
      ]
    },
    {
      "id": "security-abuse-prevention",
      "personal_data": true,
      "purpose": "Enforce public mutation rate limits using HMAC-derived principals without storing raw IP/session credentials.",
      "retention": "short-fixed-window-plus-cleanup",
      "public_by_default": false,
      "third_party_export_default": false,
      "tables": [
        "rate_limit_buckets"
      ]
    },
    {
      "id": "calibration-consent-receipts",
      "personal_data": true,
      "purpose": "Represent explicit purpose-specific psychometric calibration participation consent separately from ordinary diagnosis/product analytics after future activation.",
      "retention": "owner-session-bound-engineering-behavior; future row-level calibration artifacts are governed separately by calibration-governance-policy-v0.1-dev",
      "public_by_default": false,
      "third_party_export_default": false,
      "collection_enabled": false,
      "tables": [
        "calibration_consent_receipts"
      ],
      "governance_policy_ref": "data/calibration/governance-policy-v0.1-dev.json"
    },
    {
      "id": "calibration-operator-governance",
      "personal_data": true,
      "purpose": "Authenticate pseudonymous calibration operators, bind least-privilege research roles, record two-person export decisions and retain bounded append-only operator accountability metadata.",
      "retention": "operator-credential-until-revoked-or-governed-cleanup; operator-audit-365-days-engineering-baseline",
      "public_by_default": false,
      "third_party_export_default": false,
      "collection_enabled": false,
      "tables": [
        "calibration_operators",
        "calibration_operator_roles",
        "calibration_export_requests",
        "calibration_operator_audit_events"
      ]
    },
    {
      "id": "calibration-withdrawal-deletion-control",
      "personal_data": true,
      "purpose": "Maintain a pseudonymous calibration-record deletion target while consent is active and retain bounded append-only withdrawal/deletion events after the active link disappears.",
      "retention": "active-record-link-owner-consent-bound; deletion-journal-retained-as-privacy-control-evidence-under-calibration-governance-policy",
      "public_by_default": false,
      "third_party_export_default": false,
      "collection_enabled": false,
      "tables": [
        "calibration_record_links",
        "calibration_deletion_events"
      ]
    },
    {
      "id": "calibration-answer-storage",
      "personal_data": true,
      "purpose": "Store purpose-separated pseudonymous raw item responses for the exact frozen closed-beta calibration wave after future activation, independently from ordinary diagnostic/session storage.",
      "retention": "engineering-candidate-max-180-days-after-wave-close-with-earlier-withdrawal-or-owner-deletion-precedence; offline purge executor still required before collection activation",
      "public_by_default": false,
      "third_party_export_default": false,
      "collection_enabled": false,
      "runtime_access_allowed": false,
      "derived_scores_or_codes_stored": false,
      "tables": [
        "calibration_records",
        "calibration_item_responses"
      ],
      "governance_policy_ref": "data/calibration/governance-policy-v0.1-dev.json"
    }
  ],
  "prohibited_default_collection": [
    "real_name",
    "email",
    "phone",
    "postal_address",
    "precise_geolocation",
    "employer",
    "health_history",
    "political_identity",
    "religious_identity",
    "sexual_data",
    "biometric_media"
  ]
}
