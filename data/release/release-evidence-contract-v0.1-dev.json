    "data/release/release-policy-v0.1-dev.json",
    "data/release/assessment-dev-v0.3.json",
    "data/release/public-launch-gate-v0.1-dev.json",
    "data/release/production-model-activation-gate-v0.1-dev.json",
    "data/release/production-evidence-registry-v0.1-dev.json",
    "data/code-schema/v0.1-dev.json",
    "data/content/dev-v0.3.json",
    "data/illustration/v0.1-dev/asset-production-registry.json",
    "data/type-catalog/v0.1-dev/editorial-review-ledger.ja.json"
  ],
  "migration_glob": "drizzle/*.sql",
  "required_summary_fields": [
    "source_commit",
    "requirements_version",
    "candidate_model_version",
    "candidate_version_tuple",
    "code_schema_public_use",
    "public_launch_ready",
    "production_activation_allowed",
    "pending_production_evidence",
    "illustration_production_counts",
