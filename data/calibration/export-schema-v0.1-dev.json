    "accessTokenHash",
    "publicToken",
    "publicTokenHash",
    "ipAddress",
    "preciseLocation",
    "email",
    "realName",
    "traitScores",
    "traitVector",
    "coreCode",
    "extendedCode",
    "responseQuality",
    "interactionActiveIds",
    "resultProse",
    "productAnalytics",
    "operationalLogs",
    "freeText",
    "retestLinkId"
  ],
  "manifest_requirements": [
    "exportSchemaVersion",
    "waveId",
    "consentVersion",
    "purposeId",
    "assessmentModelVersion",
    "itemBankVersion",
    "scoringVersion",
    "traitDictionaryVersion",
    "locale",
    "rowCount"
  ],
  "notes": [
    "This schema is an offline/domain contract only; it does not authorize or implement a runtime export endpoint/job.",
    "Records may only be materialized after separate consent/legal/governance activation.",
    "Retest linkage, demographics and timing require a new reviewed schema version instead of silent field expansion."
  ]
}
