  "decision_requires_role": "calibration-export-approver",
  "requester_may_approve_own_request": false,
  "decision_audit_required": true,
  "production_provisioning_complete": false,
  "notes": [
    "The export control CLI governs request/review/approve/reject only; it does not materialize calibration records or artifacts.",
    "The frozen Wave JA-01 scope is loaded from repository contracts and independently enforced in PostgreSQL migration 0010.",
    "Actual production control-role provisioning remains external evidence."
  ]
