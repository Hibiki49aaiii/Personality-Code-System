{
  "export_control_policy_version": "calibration-export-control-policy-v0.1-dev",
  "status": "engineering-implemented-runtime-materializer-disabled",
  "runtime_web_surface_enabled": false,
  "raw_export_materializer_enabled": false,
  "collection_enabled": false,
