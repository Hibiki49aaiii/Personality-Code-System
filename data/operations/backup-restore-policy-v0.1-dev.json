  "privacy_restore_boundary": {
    "older_backup_may_contain_later_deleted_data": true,
    "deletion_journal_replay_required_before_public_traffic": true,
    "independently_durable_deletion_journal_implemented": false,
    "restored_retention_cleanup_required": true,
    "public_share_resurrection_must_be_prevented": true,
    "production_restore_privacy_safe": false
  },
  "production_restore_evidence_complete": false,
  "external_evidence_required": [
    "provider-backup-encryption-and-retention-configuration",
    "provider-backup-access-control",
    "production-equivalent-restore-rehearsal",
    "independently-durable-deletion-journal-or-equivalent",
    "deletion-replay-proof-before-public-traffic",
    "post-restore-retention-cleanup-proof",
    "restored-public-share-non-resurrection-proof"
  ]
}
