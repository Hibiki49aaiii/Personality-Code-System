# Personality Code System runtime configuration template.
# Secret values MUST be injected by the deployment secret store and MUST NOT be committed.

# Required server-only PostgreSQL connection string.
DATABASE_URL=

# Required server-only HMAC secret (production minimum: 32 characters).
PCS_RATE_LIMIT_SECRET=

# Canonical public origin. Production must use HTTPS.
PCS_SITE_ORIGIN=https://example.invalid

# Explicit assessment release selected for new sessions.
# Current repository candidate is development/beta and is not production-activatable.
PCS_ASSESSMENT_MODEL_VERSION=assessment-dev-v0.3

# Explicit environment class. Production-mode servers must not infer this value.
PCS_DEPLOYMENT_ENV=development
