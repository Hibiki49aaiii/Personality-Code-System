{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/domain/assessment/**/*.ts",
    "src/domain/analytics/**/*.ts",
    "src/domain/release/**/*.ts",
    "src/application/assessment/**/*.ts",
    "src/infrastructure/persistence/**/*.ts",
    "tests/domain/**/*.ts",
    "tests/application/**/*.ts",
    "tests/infrastructure/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".tmp-tests"
  ]
}
